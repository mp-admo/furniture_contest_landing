<script>

document.querySelectorAll(".finalists__item").forEach((item) => {

    const wrapper = item.querySelector(".finalists__gallery-wrapper");
    const prev = item.querySelector(".finalists__button--prev");
    const next = item.querySelector(".finalists__button--next");

    if (!wrapper || !prev || !next) return;

    const scrollAmount = 500;

    next.addEventListener("click", () => {
        wrapper.scrollBy({
            left: scrollAmount,
            behavior: "smooth"
        });
    });

    prev.addEventListener("click", () => {
        wrapper.scrollBy({
            left: -scrollAmount,
            behavior: "smooth"
        });
    });

});

</script>

<script>
import { createClient } from '@supabase/supabase-js';

// 1. ИНИЦИАЛИЗАЦИЯ ВАШЕГО КЛИЕНТА SUPABASE
const supabaseUrl = 'https://dvicxtksfzftgegjicxs.supabase.co';
const supabaseAnonKey = 'sb_publishable_pJO5MElysRW4jQNNsZCNSA_ymph0yJv';
const supabase = createClient(supabaseUrl, supabaseAnonKey);

document.addEventListener('DOMContentLoaded', () => {
  // 2. ПОИСК ВСЕХ ЭЛЕМЕНТОВ ИНТЕРФЕЙСА
  const voteButtons = document.querySelectorAll('.finalists__vote-btn');
  const stickyBar = document.getElementById('sticky-vote-bar');
  const participantInfoSpan = document.getElementById('selected-participant-info');
  const confirmVoteBtn = document.getElementById('confirm-vote-btn');

  const popupOverlay = document.getElementById('vote-popup-overlay');
  const popupChosenProject = document.getElementById('popup-chosen-project');
  const closePopupBtn = document.getElementById('close-popup-btn');
  const emailInput = document.getElementById('email-input') as HTMLInputElement;
  const submitVoteBtn = document.getElementById('submit-vote-btn');

  // Функция очистки интерфейса и локальной памяти
  function cleanVoteStorage() {
    localStorage.removeItem('pending_vote_id');
    localStorage.removeItem('pending_vote_name');
    localStorage.removeItem('pending_vote_collection');
    
    if (stickyBar) stickyBar.classList.remove('show');
    if (popupOverlay) popupOverlay.classList.remove('show');
    
    voteButtons.forEach(b => {
      b.classList.remove('selected');
      b.textContent = 'Vote';
    });
  }


  // =======================================================
  // ЭТАП Б: ОБРАБОТЧИКИ ИНТЕРФЕЙСА (КЛИКИ И ПОП-АПЫ)
  // =======================================================

  // Обработка кликов по кнопкам "Vote" на карточках
  voteButtons.forEach(button => {
    button.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLButtonElement;

      const id = btn.getAttribute('data-id') || '';
      const name = btn.getAttribute('data-name') || '';
      const collection = btn.getAttribute('data-collection') || '';

      if (btn.classList.contains('selected')) {
        btn.classList.remove('selected');
        btn.textContent = 'Vote';
        if (stickyBar) stickyBar.classList.remove('show');
        
        localStorage.removeItem('pending_vote_id');
        localStorage.removeItem('pending_vote_name');
        localStorage.removeItem('pending_vote_collection');
        return;
      }

      voteButtons.forEach(b => {
        b.classList.remove('selected');
        b.textContent = 'Vote';
      });

      btn.classList.add('selected');
      btn.textContent = 'Selected';

      if (participantInfoSpan) {
        participantInfoSpan.textContent = `${id} ${name} (${collection})`;
      }
      if (stickyBar) stickyBar.classList.add('show');

      localStorage.setItem('pending_vote_id', id);
      localStorage.setItem('pending_vote_name', name);
      localStorage.setItem('pending_vote_collection', collection);
    });
  });

  // Открытие поп-апа верификации по кнопке "Confirm Vote"
  if (confirmVoteBtn) {
    confirmVoteBtn.addEventListener('click', () => {
      const id = localStorage.getItem('pending_vote_id') || '';
      const name = localStorage.getItem('pending_vote_name') || '';
      const collection = localStorage.getItem('pending_vote_collection') || '';

      if (id && name && collection) {
        if (popupChosenProject) {
          popupChosenProject.textContent = `${id} ${name} (${collection})`;
        }
        if (popupOverlay) {
          popupOverlay.classList.add('show');
        }
      }
    });
  }

  // Клик по крестику — закрыть поп-ап
  if (closePopupBtn) {
    closePopupBtn.addEventListener('click', () => {
      if (popupOverlay) popupOverlay.classList.remove('show');
    });
  }

  // Клик по серой области вокруг поп-апа — закрыть его
  if (popupOverlay) {
    popupOverlay.addEventListener('click', (e) => {
      if (e.target === popupOverlay) {
        popupOverlay.classList.remove('show');
      }
    });
  }

  // Отправка голоса
if (submitVoteBtn) {
  submitVoteBtn.addEventListener('click', async () => {

    const email = emailInput.value.trim().toLowerCase();

    if (!email) {
      alert('Please enter your email address.');
      return;
    }

    // Простая проверка email
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!emailRegex.test(email)) {
      alert('Please enter a valid email address.');
      return;
    }

    const participantId = localStorage.getItem('pending_vote_id');
    const participantName = localStorage.getItem('pending_vote_name');
    const collectionName = localStorage.getItem('pending_vote_collection');

    if (!participantId || !participantName || !collectionName) {
      alert('Please select a participant first.');
      return;
    }

    // Проверяем, голосовал ли уже этот email
    const { data: existingVote, error: checkError } = await supabase
        .from('votes')
        .select('id')
        .eq('user_email', email)
        .maybeSingle();

        console.log("CHECK ERROR:", checkError);
        console.log("CHECK DATA:", existingVote);

        if (checkError) {
            alert("An error occurred while verifying your information.");
            return;
        }

    if (existingVote) {
      alert('This email address has already been used to vote.');
      return;
    }

    // Записываем голос
    const { error: insertError } = await supabase
      .from('votes')
      .insert([
        {
          user_email: email,
          participant_id: participantId,
          participant_name: participantName,
          collection_name: collectionName
        }
      ]);

    if (insertError) {
      console.error(insertError);
      alert('Failed to submit your vote.');
      return;
    }

    alert('Thank you! Your vote has been submitted successfully.');

        cleanVoteStorage();

        if (emailInput) {
            emailInput.value = '';
        }

    cleanVoteStorage();


    });

}
});


</script>