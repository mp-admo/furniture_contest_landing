---
import Layout from "../../layouts/Layout.astro";
---


<Layout title="Finalists | Woodara Design Contest">

    <!-- EN VERSION -->
    <section id="selected" class="finalists">

        <div class="container">

            <!-- heading -->
            <div class="finalists__heading">

                <span class="finalists__subtitle">
                    Public voting
                </span>

                <h3 class="finalists__main-title">

                    Choose Your Favorite

                    <span class="finalists__main-title-italic">
                        Public Vote
                    </span>

                </h3>


                <p class="finalists__description">
                    Following the jury's selection, the projects below have advanced to the final stage of the competition. Explore each collection, choose your favorite design, and cast your vote to help determine the competition winner.
                </p>

            </div>


            <!-- finalists -->
            <div class="finalists__list">

                <!-- 01 finalist -->
                <article class="finalists__item">

                    <div class="finalists__top">

                        <!-- left -->
                        <div class="finalists__left">

                            <div class="finalists__info">

                                <span class="finalists__number">
                                    01
                                </span>

                                <div class="finalists__content">

                                    <h5 class="finalists__title">
                                        Naufal Ibra Syahroni
                                    </h5>

                                    <span class="finalists__collection">
                                        KADA Collection
                                    </span>

                                </div>

                            </div>

                            <p class="finalists__text">
                                The KADA Collection is inspired by the Torajan tradition of Ma'kombongan, a cultural practice that celebrates conversation, togetherness, and mutual respect. These values are translated into contemporary furniture through honest wooden construction, exposed joinery, and woven rattan as a defining design element. Each piece is thoughtfully crafted to provide ergonomic comfort while creating spaces that encourage interaction and strengthen connections between people.
                            </p>

                        </div>

                        <!-- right -->
                        <div class="finalists__right">

                            <div class="finalists__vote-wrapper">

                                <button
                                    class="finalists__vote-btn"
                                    data-id="01"
                                    data-name="Naufal Ibra Syahroni"
                                    data-collection="KADA Collection"
                                >
                                    Vote
                                </button>

                            </div>

                            <div class="finalists__controls">

                                <button class="finalists__button finalists__button--prev">
                                    <img src="/arrow_left.svg" alt="">
                                </button>

                                <button class="finalists__button finalists__button--next">
                                    <img src="/arrow_right.svg" alt="">
                                </button>

                            </div>

                        </div>

                    </div>

                    <!-- gallery -->
