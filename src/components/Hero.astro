<section class="hero">

    <div class="container">

        <h1 class="hero__title">
                Dari Indonesia, <br />
                <span class="hero__title--italic">Untuk Dunia.</span>
        </h1>


        <div class="hero__content">
            

            <h2 class="hero__subtitle">
                Indonesian Furniture<br>Design Contest 2026
            </h2>

            <p class="hero__description">
                Kompetisi desain mebel pertama yang membawa karya terbaik Indonesia langsung ke pasar global.
            </p>

        </div>

        
    </div>

</section>

<style>

    .hero {
        position: relative;
        background-color: #FFFFFF;
        width: 100%;
        height: calc(100vh - 6.4rem);
        display: flex;
        align-items: flex-end;
        overflow: hidden;
    }

    .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: url("/hero_image.png");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        z-index: 1;
    }

    .container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 140rem;
        height: 100%;
        padding: 6rem 2rem;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .hero__content {
        display: flex;
        flex-direction: column;
    }

    .hero__subtitle {
        display: flex;
        flex-direction: column;
        color: #111;
        font-weight: 300;
        line-height: 1.12;
        margin-bottom: 2.4rem;
    }

    .hero__title { 
        color: #111;
        font-size: clamp(4.2rem, 5vw, 10.4rem);
        margin-bottom: 3.2rem; 
    }

    .hero__title--italic {
        font-style: italic; 
        font-weight: 300;
        color: #888;
    }

    .hero__description {
        color: #111; 
        font-size: 1.5rem; 
        font-weight: 400; 
        line-height: 1.6; 
        max-width: 48rem; 
    }

    @media (max-width: 768px) {

        .hero {
            height: calc(100vh - 6.3rem);
            align-items: flex-end;
        }

        .hero::before {
            background-position: center top;
        }

        .hero__content {
            max-width: 100%;
        }

        .hero__subtitle {
            font-size: 3.2rem;
            line-height: 1.2;
            margin-bottom: 2rem;
        }
    }

</style>

