<!-- ================= AFTER JULY 22 ================= -->
<section id="application" class="application-closed">

    <div class="container">

        <!-- content -->
        <div class="application-closed__content">


            <!-- subtitle -->
            <span class="application-closed__subtitle">
                Next Stage
            </span>


            <!-- title -->
            <h3 class="application-closed__title">

                Submissions

                <span class="application-closed__title-italic">
                    Are Now Closed
                </span>

            </h3>


            <!-- description -->
            <p class="application-closed__description">
                We are currently reviewing all submitted entries.<br> The entries selected by our jury will be published by the end of the month for public voting.<br>Thank you for your interest, and we look forward to sharing the selected entries soon.
            </p>

        </div>

    </div>

</section>


<style>

    .application {
        background-color: #f2f1ee;
        padding: 6rem 0;
    }

    .application .container {
        width: 100%;
        max-width: 140rem;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .application-closed {
        background-color: #f2f1ee;
        padding: 9rem 0;
    }

    .application-closed .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .application-closed__content {
        max-width: 72rem;
        margin: 0 auto;
        text-align: center;
    }

    .application-closed__subtitle {
        display: inline-flex;
        align-items: center;
        color: #111; 
        font-size: 1.2rem; 
        font-weight: 400;
        letter-spacing: 0.2rem;
        text-transform: uppercase;
        margin-bottom: 3.2rem;
    }

    .application-closed__subtitle::before {
        content: ""; 
        display: inline-block;
        width: 0.6rem; 
        height: 0.6rem; 
        background-color: #111;
        border-radius: 50%; 
        margin-right: 1rem;
    }

    .application-closed__title {
        display: flex;
        flex-direction: column;
        color: #111;
        font-size: clamp(4.2rem, 5vw, 5.4rem);
        font-weight: 300;
        line-height: 1.12;
        letter-spacing: -0.04em;
        margin-bottom: 2rem;
    }

    .application-closed__title-italic {
        font-style: italic;
        font-weight: 300;
        color: #888;
    }

    .application-closed__description {
        color: #888888;
        font-size: 1.6rem;
        line-height: 1.7;
        max-width: 66rem;
        margin: 0 auto;
    }

    @media (max-width: 768px) {
        
        .application-closed {
            padding: 6rem 0; 
        }

        .application-closed__content {
            max-width: 100%;
        }

        .application-closed__subtitle {
            margin-bottom: 2.4rem; 
        }

        .application-closed__title {
            font-size: 3.2rem; 
            line-height: 1.2;
            margin-bottom: 2.4rem;
        }

        .application-closed__title-italic {
            color: #888888; 
        }

        .application-closed__description {
            font-size: 1.4rem;
            line-height: 1.6;
            max-width: 100%;
            margin: 0 auto 3.2rem auto; 
        }

    }

</style>