<!-- EN VERSION -->
<section class="timeline">

    <div class="container">

        <!-- heading -->
        <div class="timeline__heading">

            <span class="timeline__subtitle">
                Timeline
            </span>

            <h3 class="timeline__main-title">

                How the Competition

                <span class="timeline__main-title-italic">
                    Works
                </span>

            </h3>


            <p class="timeline__description">
                The competition consists of several stages, from registration and initial submissions to jury evaluation and the announcement of the winners.
            </p>

        </div>

        <!-- content -->
        <div class="timeline__content">

            <!-- left -->
            <div class="timeline__accordion">

                <article class="timeline__item is-active">

                    <div class="timeline__wrapper">

                        <span class="timeline__number">
                            01
                        </span>

                        <div class="timeline__info">

                            <h5 class="timeline__title">
                                <span class="timeline__title-text">
                                    Registration Period
                                </span>
                                
                                <span class="timeline__date">
                                    15.06 - 22.07
                                </span>
                            </h5>

                            <div class="timeline__content-box">

                                <p class="timeline__text">
                                    Participants complete the registration form and submit the required personal information to enter the competition.
                                </p>

                            </div>

                        </div>

                    </div>

                </article>

                <article class="timeline__item">

                    <div class="timeline__wrapper">

                        <span class="timeline__number">
                            02
                        </span>

                        <div class="timeline__info">

                            <h5 class="timeline__title">
                                <span class="timeline__title-text">
                                    Initial Submission Stage
                                </span>

                                <span class="timeline__date">
                                    15.06 - 22.07
                                </span>
                            </h5>

                            <div class="timeline__content-box">

                                <p class="timeline__text">
                                    Participants must submit three furniture products:
                                    <br>
                                    1. Armchair&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2. Chair&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3. Dining Table
                                    <br><br>
                                    Required documents:
                                    <br>
                                    • Material specifications
                                    <br>
                                    • Collection concept and design philosophy
                                    <br>
                                    • Inspiration behind the collection
                                </p>

                            </div>

                        </div>

                    </div>

                </article>

                <article class="timeline__item">

                    <div class="timeline__wrapper">

                        <span class="timeline__number">
                            03
                        </span>

                        <div class="timeline__info">

                            <h5 class="timeline__title">
                                <span class="timeline__title-text">
                                    Top 20 Selection
                                </span>

                                <span class="timeline__date">
                                    24.06 - 29.07
                                </span>
                            </h5>

                            <div class="timeline__content-box">

                                <p class="timeline__text">
                                    The jury panel selects the 20 strongest projects to advance to the public voting stage.
                                </p>

                            </div>

                        </div>

                    </div>

                </article>

                <article class="timeline__item">

                    <div class="timeline__wrapper">

                        <span class="timeline__number">
                            04
                        </span>

                        <div class="timeline__info">

                            <h5 class="timeline__title">
                                <span class="timeline__title-text">
                                    Collection Development Stage
                                </span>

                                <span class="timeline__date">
                                    29.07 - 31.08
                                </span>
                            </h5>

                            <div class="timeline__content-box">

                                <p class="timeline__text">
                                    Selected participants begin developing their full collection.
                                    <br><br>
                                    Indoor Furniture:
                                    <br>
                                    1. Dresser&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2. Coffee Table&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3. Bedside Table
                                    <br>
                                    4. Sofa
                                    <br><br>
                                    Outdoor Furniture:
                                    <br>
                                    4. Sun Lounger&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;5. Garden Armchair
                                    <br>
                                    6. Outdoor Chair&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;7. Small Outdoor Sofa
                                </p>

                            </div>

                        </div>

                    </div>

                </article>

                <article class="timeline__item">

                    <div class="timeline__wrapper">

                        <span class="timeline__number">
                            05
                        </span>

                        <div class="timeline__info">

                            <h5 class="timeline__title">
                                <span class="timeline__title-text">
                                    Public Voting
                                </span>

                                <span class="timeline__date">
                                    31.07 - 05.09
                                </span>
                            </h5>

                            <div class="timeline__content-box">

                                <p class="timeline__text">
                                    The selected collections will be published for public voting and evaluation by the jury panel.
                                </p>
                            
                            </div>

                        </div>

                    </div>

                </article>

                <article class="timeline__item">

                    <div class="timeline__wrapper">

                        <span class="timeline__number">
                            06
                        </span>

                        <div class="timeline__info">

                            <h5 class="timeline__title">
                                <span class="timeline__title-text">
                                    Final Evaluation
                                </span>

                                <span class="timeline__date">
                                    05.09 - 10.09
                                </span>
                            </h5>

                            <div class="timeline__content-box">

                                <p class="timeline__text">
                                    The jury conducts the final assessment of all collections and prepares the official competition results.
                                </p>
                            
                            </div>

                        </div>

                    </div>

                </article>

                <article class="timeline__item">

                    <div class="timeline__wrapper">

                        <span class="timeline__number">
                            07
                        </span>

                        <div class="timeline__info">

                            <h5 class="timeline__title">
                                <span class="timeline__title-text">
                                    Winner Announcement
                                </span>

                                <span class="timeline__date">
                                    11.09
                                </span>
                            </h5>

                            <div class="timeline__content-box">

                                <p class="timeline__text">
                                    The competition results will be officially announced through the website and Woodara's communication channels.
                                </p>

                            </div>
                        </div>

                    </div>

                </article>

            </div>

             <!-- right -->
            <ul class="timeline__gallery">

                <li class="timeline__image">
                    <img src="/timeline/timeline_image_01.webp" alt="">
                </li>

                <li class="timeline__image">
                    <img src="/timeline/timeline_image_02.webp" alt="">
                </li>

                <li class="timeline__image">
                    <img src="/timeline/timeline_image_03.webp" alt="">
                </li>

                <li class="timeline__image">
                    <img src="/timeline/timeline_image_04.webp" alt="">
                </li>

                <li class="timeline__image">
                    <img src="/timeline/timeline_image_05.webp" alt="">
                </li>

                <li class="timeline__image">
                    <img src="/timeline/timeline_image_06.webp" alt="">
                </li>

                <li class="timeline__image">
                    <img src="/timeline/timeline_image_07.webp" alt="">
                </li>

                <li class="timeline__image">
                    <img src="/timeline/timeline_image_08.webp" alt="">
                </li>

                <li class="timeline__image timeline__image--mobile-only">
                    <img src="/timeline/timeline_image_09.webp" alt="">
                </li>
                
            </ul>

        </div>

    </div>

</section>

<style>

    .timeline {
        background-color: #f2f1ee;
        padding: 8rem 0;
    }

    .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .timeline__heading {
        max-width: 72rem;
        margin-bottom: 8rem;
    }

    .timeline__subtitle {
        display: inline-flex;
        align-items: center;
        color: #111; 
        font-size: 1.2rem; 
        font-weight: 400;
        letter-spacing: 0.2rem;
        text-transform: uppercase;
        margin-bottom: 3.2rem;
    }

    .timeline__subtitle::before {
        content: ""; 
        display: inline-block;
        width: 0.6rem; 
        height: 0.6rem; 
        background-color: #111;
        border-radius: 50%; 
        margin-right: 1rem; 
    }

    .timeline__main-title {
        display: flex;
        flex-direction: column;
        color: #111;
        font-size: clamp(4.2rem, 5vw, 5.4rem);
        max-width: 60rem;
        font-weight: 300;
        line-height: 1.12;
        letter-spacing: -0.04em;
    }

    .timeline__main-title-italic {
        font-style: italic;
        color: #888;
    }

    .timeline__description {
        margin-top: 3.2rem;
        color: #888;
        font-size: 1.6rem;
        line-height: 1.7;
        max-width: 56rem;
    }

    .timeline__content {
        display: grid;
        grid-template-columns: 58% 1fr;
        gap: 8rem;
        align-items: start;
    }

    .timeline__accordion {
        display: flex;
        flex-direction: column;
    }

    .timeline__item {
        position: relative;
        padding: 3.5rem 0 2rem;
        border-bottom: 1px solid rgba(90, 90, 90, 0.2);
    }

    .timeline__item:first-child {
        padding-top: 0;
    }

    .timeline__wrapper {
        display: flex;
        align-items: flex-start;
        gap: 2rem;
    }

    .timeline__number {
        width: 6rem;
        flex-shrink: 0;
        color: #888;
        font-size: 1.2rem; 
        font-weight: 400;
        letter-spacing: 0.2rem;
        text-transform: uppercase;
    }

    .timeline__info {
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
    }

    .timeline__title {
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
        color: #111;
        letter-spacing: -0.02em;
        cursor: pointer;
    }

    .timeline__content-box {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.5s ease;
    }

    .timeline__item.is-active .timeline__content-box {
        max-height: 40rem;
    }

    .timeline__text {
        color: #888888;
        font-size: 1.6rem;
        line-height: 1.7;
        max-width: 50rem;
    }

    .timeline__date {
        color: #888;
        font-size: 2rem;
        font-weight: 400;
    }

    .timeline__gallery {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
    }

    .timeline__image {
        aspect-ratio: 1 / 1;
        overflow: hidden;
    }

    .timeline__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .timeline__image--mobile-only {
        display: none;
    }
    

    @media (max-width: 768px) {

        .timeline {
            padding: 5rem 0;
        }

        .timeline__heading {
            margin-bottom: 4rem;
        }

        .timeline__subtitle {
            margin-bottom: 2rem;
        }

        .timeline__main-title {
            font-size: 3.2rem;
            line-height: 1.2;
        }

        .timeline__description {
            margin-top: 2rem;
            font-size: 1.4rem;
            max-width: 100%;
        }

        .timeline__content {
            grid-template-columns: 1fr;
            gap: 4rem;
        }

        .timeline__gallery {
            order: -1;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }

        .timeline__item {
            padding: 2rem 0 1.2rem;
        }

        .timeline__wrapper {
            gap: 1.6rem;
        }

        .timeline__number {
            width: 4rem;
            font-size: 1.1rem;
        }

        .timeline__title {
            font-size: 2rem;
            gap: 0.8rem;
            margin-bottom: 1.2rem;
        }

        .timeline__title-text {
            font-size: 2rem;
            line-height: 1.3;
        }

        .timeline__date {
            font-size: 1.6rem;
        }

        .timeline__text {
            font-size: 1.4rem;
            line-height: 1.6;
            max-width: 100%;
        }

        .timeline__image--mobile-only {
            display: block;
        }
    }

</style>

<script>

    const accordionItems = document.querySelectorAll('.timeline__item');

    accordionItems.forEach(item => {
        item.addEventListener('click', () => {

            accordionItems.forEach(otherItem => {
                otherItem.classList.remove('is-active');
            });

            item.classList.add('is-active');

        });
    });

</script>