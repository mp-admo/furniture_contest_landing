---

---

<!-- EN VERSION -->
<section id="requirements" class="requirements">

    <div class="container">

        <!-- heading -->
        <div class="requirements__heading">

            <!-- heading-left-->
            <div class="requirements__heading-left">

                <span class="requirements__subtitle">
                    How to Participate
                </span>

                <h3 class="requirements__main-title">

                    What We Are

                    <span class="requirements__main-title-italic">
                        Looking For
                    </span>

                </h3>

            </div>

            <div class="requirements__heading-right">

                <p class="requirements__description">
                    This competition is open to Indonesian furniture designers, interior designers, architects, design students, independent makers, and small creative studios. Participants should have basic 3D modeling skills and be able to prepare a professional presentation for their submitted collection.
                </p>

                <div class="requirements__downloads">

                    <a 
                    href="/woodara_competition.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="requirements__download-btn">
                    Competition Brief
                    </a>

                </div>

            </div>

        </div>

        <!-- content -->
        <div class="requirements__content">


            <!-- left side -->
            <div class="requirements__visual">

                <model-viewer
                    src="/cover_chair.glb"
                    camera-controls
                    class="requirements__model">
                </model-viewer>

            </div>


            <!-- accordion -->
            <div class="requirements__accordion">

                <!-- item -->
                <article class="requirements__item is-active">

                    <div class="requirements__wrapper">

                        <!-- number -->
                        <span class="requirements__number">
                            01
                        </span>

                        <!-- info -->
                        <div class="requirements__info">
    
                            <h5 class="requirements__title">
                                Design Manifesto
                            </h5>
                            
                            <div class="requirements__content-box">

                                <p class="requirements__text">
                                    Explain the inspiration, philosophy, and core idea behind your collection. Show how your concept is translated into the final product design.
                                </p>
                            
                            </div>
                            
                        </div>

                    </div>

                </article>

                <!-- item -->
                <article class="requirements__item">

                    <div class="requirements__wrapper">

                        <!-- number -->
                        <span class="requirements__number">
                            02
                        </span>

                        <!-- info -->
                        <div class="requirements__info">

                            <h5 class="requirements__title">
                                3D Visualization
                            </h5>

                            <div class="requirements__content-box">

                                <p class="requirements__text">
                                    Include high-quality 3D renderings for each product. Provide at least three different views that clearly showcase the form, proportions, and key details.
                                </p>
                            
                            </div>

                        </div>

                    </div>

                </article>

                <!-- item -->
                <article class="requirements__item">

                    <div class="requirements__wrapper">

                        <!-- number -->
                        <span class="requirements__number">
                            03
                        </span>

                        <!-- info -->
                        <div class="requirements__info">

                            <h5 class="requirements__title">
                                Technical Drawings
                            </h5>

                            <div class="requirements__content-box">

                                <p class="requirements__text">
                                    Submit product drawings with key dimensions, clear proportions, and views that help explain the product's form and construction.
                                </p>
                            
                            </div>

                        </div>

                    </div>

                </article>


                <!-- item -->
                <article class="requirements__item">

                    <div class="requirements__wrapper">

                        <!-- number -->
                        <span class="requirements__number">
                            04
                        </span>

                        <!-- info -->
                        <div class="requirements__info">

                            <h5 class="requirements__title">
                                Material Specifications
                            </h5>

                            <div class="requirements__content-box">

                            <p class="requirements__text">
                                JDescribe the materials used in each product, including material combinations, finishes, and the reasoning behind your selections.
                            </p>

                            </div>

                        </div>

                    </div>

                </article>

                <!-- item -->
                <article class="requirements__item">

                    <div class="requirements__wrapper">

                        <!-- number -->
                        <span class="requirements__number">
                            05
                        </span>

                        <!-- info -->
                        <div class="requirements__info">

                            <h5 class="requirements__title">
                                Social Media Participation
                            </h5>

                            <div class="requirements__content-box">

                                <p class="requirements__text">
                                    Follow our social media channels to stay updated with announcements, competition news, and important updates.
                                </p>

                            </div>

                        </div>

                    </div>

                </article>

                <!-- item -->
                <article class="requirements__item">

                    <div class="requirements__wrapper">

                        <!-- number -->
                        <span class="requirements__number">
                            06
                        </span>

                        <!-- info -->
                        <div class="requirements__info">

                            <h5 class="requirements__title">
                                Important Notes
                            </h5>

                            <div class="requirements__content-box">

                                <p class="requirements__text">
                                    Make sure all required documents and materials are completed before submission. Incomplete entries will not be considered during the evaluation process.
                                </p>

                            </div>

                        </div>

                    </div>

                </article>


            </div>

        </div>

    </div>

</section>

<style>

    .requirements {
        background-color: #f9f9f9;
        padding: 8rem 0;
    }

    .requirements .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .requirements__heading {
        display: grid;
        grid-template-columns: 45% 1fr;
        gap: 8rem;
        margin-bottom: 10rem;
    }

    .requirements__heading-right {
        width: 100%;
    }

    .requirements__subtitle {
        display: inline-flex;
        align-items: center;
        color: #111; 
        font-size: 1.2rem; 
        font-weight: 400;
        letter-spacing: 0.2rem;
        text-transform: uppercase;
        margin-bottom: 3.2rem;
    }

    .requirements__subtitle::before {
        content: ""; 
        display: inline-block;
        width: 0.6rem; 
        height: 0.6rem; 
        background-color: #111;
        border-radius: 50%; 
        margin-right: 1rem; 
    }

    .requirements__main-title {
        display: flex;
        flex-direction: column;
        color: #111;
        font-size: clamp(4.2rem, 5vw, 5.4rem);
        font-weight: 300;
        line-height: 1.12;
        letter-spacing: -0.04em;
    }


    .requirements__main-title-italic {
        font-style: italic;
        font-weight: 300;
        color: #888;
    }

    .requirements__description {
        margin-top: 3.2rem;
        color: #888;
        font-size: 1.6rem;
        line-height: 1.7;
    }

    .requirements__downloads {
        display: flex;
        gap: 1.6rem;
        margin-top: 3.2rem;
    }

    .requirements__download-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24rem;
        height: 6rem;
        background: #d62828;
        color: #fff;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-size: 1.2rem;
        font-weight: 500;
        transition: 0.3s ease;
    }

    .requirements__download-btn:hover {
        background: #b71c1c;
        transform: translateY(-2px);
    }


    .requirements__content {
        display: grid;
        grid-template-columns: 45% 1fr;
        gap: 8rem;
        align-items: start;
    }

    .requirements__visual {
        aspect-ratio: 1 / 1;
        background: #f9f9f9;
        background-image:
        
        background-size: 4rem 4rem;
    }

    .requirements__model {
        width: 100%;
        height: 100%;
    }

    .requirements__accordion {
        display: flex;
        flex-direction: column;
        height: 62rem;
    }

    .requirements__item {
        position: relative;
        padding: 3.5rem 0 2.5rem;
        border-bottom: 1px solid rgba(90, 90, 90, 0.2);
    }

    .requirements__item:first-child {
        padding-top: 0;
    }

    .requirements__wrapper {
        display: flex;
        align-items: flex-start;
        gap: 2rem;
    }

    .requirements__number {
        width: 6rem;
        flex-shrink: 0;
        color: #888;
        font-size: 1.2rem;
        font-weight: 400;
        letter-spacing: 0.2rem;
        text-transform: uppercase;
    }

    .requirements__info {
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
    }

    .requirements__title {
        color: #111;
        letter-spacing: -0.02rem;
        cursor: pointer;
    }

    .requirements__content-box {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.5s ease;
    }

    .requirements__item.is-active .requirements__content-box {
        max-height: 20rem;
    }

    .requirements__text {
        color: #888888;
        font-size: 1.6rem;
        line-height: 1.7;
        max-width: 64rem;
    }


    @media (max-width: 768px) {
        
        .requirements {
            padding: 5rem 0;
        }

        .requirements__heading {
            grid-template-columns: 1fr;
            gap: 2.4rem;
            margin-bottom: 4rem;
        }

        .requirements__subtitle {
            margin-bottom: 2rem;
        }

        .requirements__main-title {
            font-size: 3.2rem;
            line-height: 1.2;
        }

        .requirements__description {
            margin-top: 0;
            font-size: 1.4rem;
        }

        .requirements__downloads {
            flex-direction: column;
            gap: 1rem;
        }

        .requirements__download-btn {
            width: 100%;
            min-width: unset;
        }

        .requirements__content {
            grid-template-columns: 1fr;
            gap: 5rem;
        }

        .requirements__visual {
            position: static;
            width: 100%;
        }

        .requirements__accordion {
            border-top: none;
            height: auto;
        }

        .requirements__item {
            padding: 2rem 0 1.2rem;
        }

        .requirements__wrapper {
            gap: 1.6rem;
        }

        .requirements__info {
            gap: 1rem;
        }

        .requirements__title {
            font-size: 2rem;
        }

        .requirements__number {
            width: 4rem;
            font-size: 1.1rem;
        }

        .requirements__text {
            font-size: 1.4rem;
            line-height: 1.6;
            max-width: 100%;
            padding-bottom: 0;
        }
    }

</style>

<script>

    const accordionItems = document.querySelectorAll('.requirements__item');

    accordionItems.forEach(item => {
        item.addEventListener('click', () => {

            accordionItems.forEach(otherItem => {
                otherItem.classList.remove('is-active');
            });

            item.classList.add('is-active');

        });
    });

</script>

<script
    type="module"
    src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js">
</script>